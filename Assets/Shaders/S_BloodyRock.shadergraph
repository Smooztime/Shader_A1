{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "4619c6840e714eafb87d012530c9ccc0",
    "m_Title": "World Space Shader",
    "m_Content": "\tThis is the shader I created for World Space Shader. Actually, I created 2 textures that can lerp it together, and made a position node to used the world space of Normal. Then used the Noise to made it looked like Lava.\n\t\n\tSubtract and divide it to control the side of the textures and put it to T of all Lerp. Added emission node to made it glow like Lava.",
    "m_TextSize": 2,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -3123.0,
        "y": 600.0,
        "width": 1020.1298828125,
        "height": 446.46820068359377
    },
    "m_Group": {
        "m_Id": ""
    }
}

