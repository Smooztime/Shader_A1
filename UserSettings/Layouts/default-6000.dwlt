    0,\n    \"m_Type\": \"UnityEditor.ShaderGraph.StickyNoteData\",\n    \"m_ObjectId\":
    \"4619c6840e714eafb87d012530c9ccc0\",\n    \"m_Title\": \"World Space Shader\",\n   
    \"m_Content\": \"\\tThis is the shader I created for World Space Shader. Actually,
    I created 2 textures that can lerp it together, and made a position node to used
    the world space of Normal. Then used the Noise to made it looked like Lava.\\n\\t\\n\\tSubtract
    and divide it to control the side of the textures and put it to T of all Lerp.
    Added emission node to made it glow like Lava.\",\n    \"m_TextSize\": 2,\n   
    \"m_Theme\": 0,\n    \"m_Position\": {\n        \"serializedVersion\": \"2\",\n       
    \"x\": -3123.0,\n        \"y\": 600.0,\n        \"width\": 1020.1298828125,\n       
    \"height\": 446.46820068359377\n    },\n    \"m_Group\": {\n        \"m_Id\":
